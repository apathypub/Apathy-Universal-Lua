<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Apathy.Controls">

    <!-- Restyled built-in WPF controls. Every style sets OverridesDefaultStyle so the
         Windows theme (Aero2) can't leak colors/fonts into the menu. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Apathy;component/Themes/Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================ Scrolling ============================ -->

    <Style x:Key="Sk.InvisibleRepeat" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sk.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Sk.ScrollThumb.Fill}"
                            BorderBrush="{StaticResource Sk.Black}" BorderThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sk.ScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{StaticResource Sk.ScrollTrack}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Sk.InvisibleRepeat}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Sk.InvisibleRepeat}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Sk.ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical-only scroll viewer used inside group boxes, lists and dropdowns. -->
    <Style x:Key="Sk.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Style="{StaticResource Sk.ScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Tabs ============================ -->

    <Style TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <!-- The texture covers everything; the tab column paints its dark
                         background per tab so the selected tab "opens" into the page. -->
                    <Grid Background="{DynamicResource Sk.Pattern}" KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Height="16" Background="{StaticResource Sk.TabBg}"
                                    BorderBrush="{StaticResource Sk.Line}" BorderThickness="0,0,1,0">
                                <Border BorderBrush="{StaticResource Sk.Black}" BorderThickness="0,0,1,0"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Top" IsItemsHost="True"/>
                            <Border Background="{StaticResource Sk.TabBg}"
                                    BorderBrush="{StaticResource Sk.Line}" BorderThickness="0,0,1,0">
                                <Border BorderBrush="{StaticResource Sk.Black}" BorderThickness="0,0,1,0"/>
                            </Border>
                        </DockPanel>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                          ContentSource="SelectedContent" Margin="18,18,18,18"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabItem.Header is an icon glyph (Segoe MDL2 Assets); ToolTip holds the name.
         Font/foreground are set on the header presenter only, otherwise they would
         be inherited by the page content. -->
    <Style TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- TabControl copies these onto PART_SelectedContentHost; pages must fill the area. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Height="64" Background="Transparent">
                        <Border x:Name="Inactive" Background="{StaticResource Sk.TabBg}"
                                BorderBrush="{StaticResource Sk.Line}" BorderThickness="0,0,1,0">
                            <Border BorderBrush="{StaticResource Sk.Black}" BorderThickness="0,0,1,0"/>
                        </Border>
                        <Grid x:Name="Active" Visibility="Collapsed">
                            <Border Height="1" VerticalAlignment="Top" Margin="0,0,1,0" Background="{StaticResource Sk.Black}"/>
                            <Border Height="1" Width="1" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{StaticResource Sk.Line}"/>
                            <Border Height="1" VerticalAlignment="Top" Margin="0,1,0,0" Background="{StaticResource Sk.Line}"/>
                            <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,1" Background="{StaticResource Sk.Line}"/>
                            <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,1,0" Background="{StaticResource Sk.Black}"/>
                            <Border Height="1" Width="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="{StaticResource Sk.Line}"/>
                        </Grid>
                        <ContentPresenter x:Name="Icon" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource Sk.IconFont}"
                                          TextElement.FontSize="30"
                                          TextElement.Foreground="{StaticResource Sk.Icon}">
                            <!-- Header can be a glyph string or a Geometry (TabIcons); drawing the geometry
                                 here makes it take the hover/selected colors set on this presenter. -->
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <c:GeometryIcon Data="{Binding}" Size="32"/>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{StaticResource Sk.Icon.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Inactive" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Active" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{StaticResource Sk.Icon.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sub-tabs inside a page: a group box (header = TabControl.Tag) holding a row of icons,
         the selected category's content below it. Usage: Style="{StaticResource Sk.CategoryTabs}". -->
    <Style x:Key="Sk.CategoryTab" TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border MinWidth="60" Height="32" Padding="12,0" Background="Transparent">
                        <ContentPresenter x:Name="Icon" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource Sk.IconFont}"
                                          TextElement.FontSize="28"
                                          TextElement.Foreground="{StaticResource Sk.Icon}">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type Geometry}">
                                    <c:GeometryIcon Data="{Binding}" Size="30"/>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{StaticResource Sk.Icon.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{StaticResource Sk.Icon.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sk.CategoryTabs" TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Sk.CategoryTab}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Tight padding: the icons sit just under the title. -->
                        <GroupBox Header="{TemplateBinding Tag}" Padding="14,4,8,3">
                            <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </GroupBox>
                        <!-- Clipped so the page can slide in (c:SlideTransition) without drawing over the frame. -->
                        <Border Grid.Row="2" ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Group box ============================ -->

    <!-- Double 1px border (black + gray) with the bold title sitting in a gap of the top edge.
         Content scrolls when it doesn't fit, like the original. -->
    <Style TargetType="GroupBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Padding" Value="12,11,8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- sides + bottom -->
                        <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3"
                                Background="{StaticResource Sk.GroupBg}"
                                BorderBrush="{StaticResource Sk.Black}" BorderThickness="1,0,1,1">
                            <Border BorderBrush="{StaticResource Sk.Line}" BorderThickness="1,0,1,1"/>
                        </Border>

                        <!-- top edge, split around the title -->
                        <Border Grid.Row="1" Grid.Column="0" Height="1" VerticalAlignment="Top" Background="{StaticResource Sk.Black}"/>
                        <Border Grid.Row="1" Grid.Column="0" Height="1" VerticalAlignment="Bottom" Margin="1,0,0,0" Background="{StaticResource Sk.Line}"/>
                        <Border Grid.Row="1" Grid.Column="2" Height="1" VerticalAlignment="Top" Background="{StaticResource Sk.Black}"/>
                        <Border Grid.Row="1" Grid.Column="2" Height="1" VerticalAlignment="Bottom" Margin="0,0,1,0" Background="{StaticResource Sk.Line}"/>

                        <!-- The title hangs over the top edge. The negative bottom margin keeps its height out of
                             the row sizing; otherwise an auto-height group spreads it into the 2px edge row and the
                             black and gray lines drift apart. -->
                        <ContentPresenter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ContentSource="Header"
                                          Margin="3,1,3,-8" VerticalAlignment="Top" RecognizesAccessKey="False"
                                          TextElement.FontWeight="Bold"/>

                        <ScrollViewer Grid.Row="2" Grid.ColumnSpan="3" Margin="2,1,2,2"
                                      Style="{StaticResource Sk.ScrollViewer}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Basic inputs ============================ -->

    <!-- Plain label inside a group box, aligned with checkbox text. -->
    <Style x:Key="Sk.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Margin" Value="20,0,0,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                                BorderBrush="{StaticResource Sk.Black}" BorderThickness="1"
                                Background="{StaticResource Sk.Check.Off}"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Sk.Check.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Sk.Accent.Gradient}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Sk.TextDisabled}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Margin" Value="20,2,30,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{StaticResource Sk.Black}" BorderThickness="1">
                        <Border x:Name="Bd" BorderBrush="{StaticResource Sk.Button.Inner}" BorderThickness="1"
                                Background="{StaticResource Sk.Button}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sk.Button.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sk.Button.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Sk.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Background" Value="{StaticResource Sk.Input}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Sk.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Sk.Accent}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="20,0,30,6"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Sk.Black}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Sk.Frame.Light}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same look as TextBox. -->
    <Style TargetType="PasswordBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Background" Value="{StaticResource Sk.Input}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Sk.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Sk.Accent}"/>
        <Setter Property="PasswordChar" Value="*"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="20,0,30,6"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Sk.Black}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Sk.Frame.Light}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Background" Value="{StaticResource Sk.Input}"/>
        <Setter Property="Margin" Value="20,0,30,6"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Sk.Black}" BorderThickness="1">
                        <ScrollViewer Style="{StaticResource Sk.ScrollViewer}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sk.PopupHover}"/>
                        </Trigger>
                        <!-- Selection = lighter row + bold; the accent color is left free for item state
                             (e.g. loaded scripts in the Lua tab). -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sk.PopupHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Sk.Accent}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Popups ============================ -->

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource Sk.Font}"/>
        <Setter Property="FontSize" Value="{StaticResource Sk.FontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border LayoutTransform="{DynamicResource Sk.Scale}" Background="{StaticResource Sk.PopupBg}"
                            BorderBrush="{StaticResource Sk.Black}" BorderThickness="1" Padding="6,3">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource Sk.Font}"/>
        <Setter Property="FontSize" Value="{StaticResource Sk.FontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border LayoutTransform="{DynamicResource Sk.Scale}" Background="{StaticResource Sk.PopupBg}"
                            BorderBrush="{StaticResource Sk.Black}" BorderThickness="1" MinWidth="90">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
        <Setter Property="Padding" Value="8,3,12,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Sk.PopupHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Sk.Accent}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
