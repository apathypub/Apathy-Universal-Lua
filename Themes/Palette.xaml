<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:c="clr-namespace:Apathy.Controls">

    <!-- Forum look: flat near-black, monospace body, bold titles, thin separators,
         coral accent and green names. Matches the apathy.pub forum. -->

    <!-- Fonts: monospace body (the forum's terminal feel); titles are bold. -->
    <FontFamily x:Key="Sk.Font">Consolas, Cascadia Mono, Courier New</FontFamily>
    <FontFamily x:Key="Sk.Heading">Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Sk.IconFont">Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="Sk.FontSize">12</sys:Double>

    <!-- Window frame: the forum has no box, just the flat page on a thin edge. -->
    <SolidColorBrush x:Key="Sk.Outline" Color="#000000"/>
    <SolidColorBrush x:Key="Sk.Frame.Light" Color="#1C1A19"/>
    <SolidColorBrush x:Key="Sk.Frame.Mid" Color="#0F0E0E"/>

    <!-- Surfaces (flat: panels are the page color, told apart by thin lines, not fills) -->
    <SolidColorBrush x:Key="Sk.Black" Color="#000000"/>
    <SolidColorBrush x:Key="Sk.Line" Color="#262422"/>
    <SolidColorBrush x:Key="Sk.TabBg" Color="#0F0E0E"/>
    <SolidColorBrush x:Key="Sk.GroupBg" Color="#0F0E0E"/>
    <SolidColorBrush x:Key="Sk.PopupBg" Color="#1A1817"/>
    <SolidColorBrush x:Key="Sk.PopupHover" Color="#232120"/>
    <SolidColorBrush x:Key="Sk.Input" Color="#161413"/>
    <SolidColorBrush x:Key="Sk.ScrollTrack" Color="#0F0E0E"/>
    <SolidColorBrush x:Key="Sk.ScrollThumb.Fill" Color="#33302E"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Sk.Text" Color="#E6E3DF"/>
    <SolidColorBrush x:Key="Sk.TextMuted" Color="#8A8781"/>
    <SolidColorBrush x:Key="Sk.TextDisabled" Color="#55524E"/>
    <SolidColorBrush x:Key="Sk.TextBind" Color="#6C6963"/>
    <SolidColorBrush x:Key="Sk.TextError" Color="#E8554B"/>

    <!-- Row numbers / dim labels, like the "01 02 03" on the forum -->
    <SolidColorBrush x:Key="Sk.TextFaint" Color="#4D4A47"/>

    <!-- Coral accent: the active nav underline and the pulse by the logo -->
    <SolidColorBrush x:Key="Sk.Coral" Color="#E8554B"/>

    <!-- Tab / icon states -->
    <SolidColorBrush x:Key="Sk.Icon" Color="#6C6963"/>
    <SolidColorBrush x:Key="Sk.Icon.Hover" Color="#B4B1AC"/>
    <SolidColorBrush x:Key="Sk.Icon.Active" Color="#E6E3DF"/>

    <!-- Control fills: flat, quiet; the accent shows state. -->
    <SolidColorBrush x:Key="Sk.Check.Off" Color="#2A2826"/>
    <LinearGradientBrush x:Key="Sk.Check.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#343230"/>
        <GradientStop Offset="1" Color="#2A2826"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Sk.Slider.Track" Color="#2A2826"/>
    <SolidColorBrush x:Key="Sk.Combo" Color="#161413"/>
    <SolidColorBrush x:Key="Sk.Combo.Hover" Color="#201E1D"/>
    <SolidColorBrush x:Key="Sk.Button" Color="#161413"/>
    <SolidColorBrush x:Key="Sk.Button.Hover" Color="#201E1D"/>
    <SolidColorBrush x:Key="Sk.Button.Pressed" Color="#121010"/>
    <SolidColorBrush x:Key="Sk.Button.Inner" Color="#2A2826"/>

    <!-- The thin strip across the top of the window: coral, like the forum's pulse line. -->
    <LinearGradientBrush x:Key="Sk.Rainbow" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#E8554B"/>
        <GradientStop Offset="1" Color="#B23A33"/>
    </LinearGradientBrush>

    <!-- Color picker helpers -->
    <DrawingBrush x:Key="Sk.Checker" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#9A9A9A" Geometry="M0,0 H6 V6 H0 Z"/>
                <GeometryDrawing Brush="#5A5A5A" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="Sk.HueStrip" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF0000"/>
        <GradientStop Offset="0.1667" Color="#FFFF00"/>
        <GradientStop Offset="0.3333" Color="#00FF00"/>
        <GradientStop Offset="0.5" Color="#00FFFF"/>
        <GradientStop Offset="0.6667" Color="#0000FF"/>
        <GradientStop Offset="0.8333" Color="#FF00FF"/>
        <GradientStop Offset="1" Color="#FF0000"/>
    </LinearGradientBrush>

    <!--
        Runtime-replaced resources (see ThemeManager). Always reference these with
        DynamicResource so accent color / menu scale changes apply live.
        Default accent is the forum's green (loaded scripts and online names share it).
    -->
    <SolidColorBrush x:Key="Sk.Accent" Color="#74C174"/>
    <LinearGradientBrush x:Key="Sk.Accent.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#74C174"/>
        <GradientStop Offset="1" Color="#45743F"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Sk.Pattern" Color="#0F0E0E"/>
    <ScaleTransform x:Key="Sk.Scale" ScaleX="1" ScaleY="1"/>

    <!-- Converters -->
    <c:InverseBoolConverter x:Key="Sk.InverseBool"/>
    <BooleanToVisibilityConverter x:Key="Sk.BoolToVis"/>

</ResourceDictionary>
