<o:OverlayWindow x:Class="Apathy.Overlay.HudWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:o="clr-namespace:Apathy.Overlay"
                 xmlns:s="clr-namespace:Apathy.Overlay"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 Title="Hud"
                 TextOptions.TextFormattingMode="Display"
                 FontFamily="{StaticResource Sk.Font}"
                 FontSize="12" FontWeight="Bold">

    <!-- Right-aligned text lines added by scripts (hud API), sitting under the watermark. -->
    <ItemsControl ItemsSource="{Binding Source={x:Static s:LuaHud.Lines}}" HorizontalAlignment="Right">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Text}" HorizontalAlignment="Right" Margin="2,1"
                           Foreground="{StaticResource Sk.Text}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="3" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</o:OverlayWindow>
