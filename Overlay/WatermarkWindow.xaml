<o:OverlayWindow x:Class="Apathy.Overlay.WatermarkWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:o="clr-namespace:Apathy.Overlay"
                 Title="Watermark"
                 TextOptions.TextFormattingMode="Display"
                 FontFamily="{StaticResource Sk.Font}"
                 FontSize="12">

    <!-- Rounded pill: an accent bar, a soft-glowing dot, then apathy | user | time. -->
    <Border CornerRadius="7" Padding="0" Margin="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="8" Opacity="0.55"/>
        </Border.Effect>
        <Border CornerRadius="7" ClipToBounds="True">
            <Border.Background>
                <SolidColorBrush Color="#0C0C0C" Opacity="0.82"/>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left accent bar -->
                <Border Width="3" Background="{DynamicResource Sk.Accent}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,4,11,4" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Sk.Accent}" VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource Sk.Text}">
                        <Run Text="apa"/><Run Text="thy" Foreground="{DynamicResource Sk.Accent}"/>
                    </TextBlock>
                    <Border Width="1" Margin="9,1" Background="{StaticResource Sk.Frame.Light}"/>
                    <TextBlock x:Name="UserText" VerticalAlignment="Center" Foreground="{StaticResource Sk.TextMuted}"/>
                    <Border Width="1" Margin="9,1" Background="{StaticResource Sk.Frame.Light}"/>
                    <TextBlock x:Name="Details" VerticalAlignment="Center" Foreground="{StaticResource Sk.TextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</o:OverlayWindow>
