<Window x:Class="Apathy.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="apathy"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Sk.Outline}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Sk.Font}"
        FontSize="{StaticResource Sk.FontSize}"
        Foreground="{StaticResource Sk.Text}">

    <Window.Resources>
        <!-- Small "x" glyph in the top-right corner. -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Sk.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="7">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Sk.IconFont}" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Flat forum look, same as the menu: one thin edge, the page colour, the wordmark with the
         coral pulse, then plain fields. -->
    <Border Width="320" LayoutTransform="{DynamicResource Sk.Scale}"
            Background="{DynamicResource Sk.Pattern}"
            BorderBrush="{StaticResource Sk.Line}" BorderThickness="1">
        <Grid>
            <StackPanel Margin="26,24,26,22">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <TextBlock Text="apathy" FontFamily="{StaticResource Sk.Heading}" FontSize="20" FontWeight="Bold"/>
                    <Polyline Points="0,6 7,6 10,1 14,11 18,6 40,6" Stroke="{StaticResource Sk.Coral}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" VerticalAlignment="Center" Margin="10,3,0,0"/>
                </StackPanel>

                <!-- Both views share one cell; the hidden one keeps its size so the window
                     doesn't jump when switching from login to loading. -->
                <Grid>
                    <StackPanel x:Name="LoginGroup">
                        <TextBlock Text="username or e-mail" Margin="0,0,0,5" Foreground="{StaticResource Sk.TextMuted}"/>
                        <TextBox x:Name="UsernameBox" Height="24" Margin="0,0,0,12"/>
                        <TextBlock Text="password" Margin="0,0,0,5" Foreground="{StaticResource Sk.TextMuted}"/>
                        <PasswordBox x:Name="PasswordInput" Height="24" Margin="0,0,0,12"/>
                        <CheckBox x:Name="RememberBox" Content="remember me" Margin="0,0,0,14"/>
                        <Button x:Name="LoginButton" Content="log in" IsDefault="True" Height="28" Margin="0,0,0,10"
                                Click="Login_Click"/>
                        <TextBlock x:Name="Status" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <!-- Accounts and premium live on apathy.pub. -->
                        <Border BorderBrush="{StaticResource Sk.Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock>
                                    <Hyperlink x:Name="RegisterLink" Click="Register_Click" TextDecorations="{x:Null}"
                                               Foreground="{StaticResource Sk.TextMuted}">register</Hyperlink>
                                </TextBlock>
                                <TextBlock Text="·" Margin="10,0" Foreground="{StaticResource Sk.TextFaint}"/>
                                <TextBlock>
                                    <Hyperlink x:Name="PremiumLink" Click="Premium_Click" TextDecorations="{x:Null}"
                                               Foreground="{StaticResource Sk.Coral}">get premium</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LoadingGroup" VerticalAlignment="Center" Visibility="Hidden">
                        <TextBlock x:Name="WelcomeText" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="LoadingStep" Foreground="{StaticResource Sk.TextMuted}"/>
                            <TextBlock x:Name="LoadingPercent" HorizontalAlignment="Right" Foreground="{StaticResource Sk.TextMuted}"/>
                        </Grid>
                        <Border Height="2" Background="{StaticResource Sk.Line}">
                            <Border Background="{DynamicResource Sk.Accent}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,4,0" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
