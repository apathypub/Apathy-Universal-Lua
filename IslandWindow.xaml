<Window x:Class="Apathy.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Apathy.Services"
        xmlns:m="clr-namespace:Apathy.Models"
        Title="apathy island"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Sk.Font}"
        FontSize="{StaticResource Sk.FontSize}"
        Foreground="{StaticResource Sk.Text}">

    <Window.Resources>
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Sk.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9" Padding="8,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Sk.Frame.Mid}"/>
                                <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Sk.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sk.IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the shadow inside the transparent window. -->
    <Border Margin="8" CornerRadius="14" Padding="10,4"
            Background="{StaticResource Sk.Outline}"
            BorderBrush="{StaticResource Sk.Frame.Light}" BorderThickness="1"
            LayoutTransform="{DynamicResource Sk.Scale}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <!-- Game-link light: red not linked, yellow connecting/trouble, green receiving events. -->
            <Ellipse Width="8" Height="8" Margin="2,0,8,0" VerticalAlignment="Center"
                     DataContext="{x:Static s:GameConnection.Instance}" ToolTip="{Binding Detail}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#E8404A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Connecting">
                                <Setter Property="Fill" Value="#E8C440"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Connected">
                                <Setter Property="Fill" Value="#5BD65B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0">
                <Run Text="apa"/><Run Text="thy" Foreground="{DynamicResource Sk.Accent}"/>
            </TextBlock>

            <Border Width="1" Margin="2,3,4,3" Background="{StaticResource Sk.Frame.Light}"/>

            <!-- Shortcuts (DataContext = menu settings): each can be turned off in Misc > Island,
                 and the arrow button after them folds them all away. -->
            <!-- Folding animates the clip's width (the shortcuts slide behind the arrow) + opacity. -->
            <Border x:Name="ShortcutsClip" ClipToBounds="True" HorizontalAlignment="Left">
            <StackPanel x:Name="Shortcuts" Orientation="Horizontal" HorizontalAlignment="Left">

                <Button Style="{StaticResource IslandButton}" ToolTip="Chat with other apathy users" Click="ChatLive_Click"
                        Visibility="{Binding IslandChatLive, Converter={StaticResource Sk.BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;"/>
                        <TextBlock Text="ChatLive" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource IslandButton}" ToolTip="Open the Lua tab" Click="Scripts_Click"
                        Visibility="{Binding IslandScripts, Converter={StaticResource Sk.BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE943;"/>
                        <TextBlock Text="Scripts" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource IslandButton}" ToolTip="Write and run your scripts" Click="Editor_Click"
                        Visibility="{Binding IslandEditor, Converter={StaticResource Sk.BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;"/>
                        <TextBlock Text="Editor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </Border>

            <Button Click="Collapse_Click">
                <TextBlock x:Name="Chevron" Text="&#xE76B;" FontFamily="{StaticResource Sk.IconFont}" FontSize="9"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IslandButton}">
                        <Setter Property="ToolTip" Value="Hide shortcuts"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IslandCollapsed}" Value="True">
                                <Setter Property="ToolTip" Value="Show shortcuts"/>
                            </DataTrigger>
                            <!-- Nothing to fold when every shortcut is turned off. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IslandChatLive}" Value="False"/>
                                    <Condition Binding="{Binding IslandScripts}" Value="False"/>
                                    <Condition Binding="{Binding IslandEditor}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Style="{StaticResource IslandButton}" ToolTip="Show / hide the menu" Click="Menu_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE700;"/>
                    <TextBlock Text="Menu" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Buttons added by loaded Lua scripts (island.button). -->
            <ItemsControl ItemsSource="{x:Static m:IslandShortcuts.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource IslandButton}" Content="{Binding Label}" Click="Shortcut_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Currently loaded scripts (Misc > Island > Active scripts); click opens their options. -->
            <ItemsControl x:Name="ActiveScripts"
                          Visibility="{Binding IslandActiveScripts, Converter={StaticResource Sk.BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource IslandButton}" ToolTip="Open this script's options" Click="ActiveScript_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Sk.Accent}" Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
