<UserControl x:Class="Apathy.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Apathy.Services"
             Background="{StaticResource Sk.GroupBg}">

    <!-- ChatLive tab: plain message lines on the left, who's online on the right. -->
    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="{StaticResource Sk.IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Sk.TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Sk.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="OtherMenu" x:Shared="False">
            <MenuItem Header="Mention" Click="Mention_Click"/>
            <MenuItem Header="Copy" Click="Copy_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="OwnMenu" x:Shared="False">
            <MenuItem Header="Copy" Click="Copy_Click"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border BorderBrush="{StaticResource Sk.Line}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             DataContext="{x:Static s:ConnectionService.Instance}" ToolTip="{Binding Detail}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E8404A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Unstable">
                                        <Setter Property="Fill" Value="#E8C440"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                        <Setter Property="Fill" Value="#5BD65B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="ChatLive" FontWeight="Bold" Margin="8,0,0,0"/>
                    <TextBlock x:Name="Subtitle" Margin="10,0,0,0" Foreground="{StaticResource Sk.TextMuted}" Text="offline"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,4,0"
                        Content="&#xE713;" ToolTip="Server" Click="Settings_Click"/>
            </Grid>
        </Border>

        <!-- Server address -->
        <Border x:Name="SettingsBar" Grid.Row="1" Visibility="Collapsed" Padding="12,8"
                BorderBrush="{StaticResource Sk.Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Sk.TextMuted}"/>
                <TextBox x:Name="ServerBox" Grid.Column="1" Margin="0" Height="22" KeyDown="ServerBox_KeyDown"/>
                <Button Grid.Column="2" Content="Connect" Width="80" Height="22" Margin="8,0,0,0" Click="Connect_Click"/>
            </Grid>
        </Border>

        <!-- Messages | online -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBlock Text="No messages yet" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Sk.TextDisabled}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=MessageList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer x:Name="MessageScroll" Style="{StaticResource Sk.ScrollViewer}"
                              ScrollChanged="MessageScroll_ScrollChanged">
                    <ItemsControl x:Name="MessageList" Margin="6,4,6,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type s:ChatMessage}">
                                <StackPanel x:Name="Item" Margin="0,8,0,0">
                                    <!-- Day divider -->
                                    <Grid x:Name="DateRow" Visibility="Collapsed" Margin="6,2,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Height="1" Background="{StaticResource Sk.Line}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DateText}" Margin="8,0" FontSize="10"
                                                   Foreground="{StaticResource Sk.TextDisabled}"/>
                                        <Border Grid.Column="2" Height="1" Background="{StaticResource Sk.Line}"/>
                                    </Grid>

                                    <!-- joined / left / disconnected -->
                                    <TextBlock x:Name="SystemView" Visibility="Collapsed" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Sk.TextDisabled}"
                                               Text="{Binding Text}"/>

                                    <!-- Message: name + time, then the text. Mentions get an accent bar. -->
                                    <Grid x:Name="MessageView" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="MentionBar" Background="{DynamicResource Sk.Accent}" Visibility="Hidden"/>
                                        <StackPanel Grid.Column="1" Margin="8,2,6,2">
                                            <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding TimeText}" Margin="8,0,0,0" FontSize="10"
                                                           VerticalAlignment="Bottom" Foreground="{StaticResource Sk.TextDisabled}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Sk.Text}" ContextMenu="{StaticResource OtherMenu}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ShowDate}" Value="True">
                                        <Setter TargetName="DateRow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="SystemView" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="MessageView" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Sk.Accent}"/>
                                        <Setter TargetName="Body" Property="ContextMenu" Value="{StaticResource OwnMenu}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMention}" Value="True">
                                        <Setter TargetName="MentionBar" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- Follow-up from the same person: no repeated name / time. -->
                                    <DataTrigger Binding="{Binding ShowHeader}" Value="False">
                                        <Setter TargetName="Item" Property="Margin" Value="0,1,0,0"/>
                                        <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger SourceName="MessageView" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="MessageView" Property="Background" Value="#1C1C1C"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Shown when messages arrive while you're reading older ones -->
                <Button x:Name="NewMessagesButton" Content="New messages" Visibility="Collapsed" Width="120" Height="22"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Click="NewMessages_Click"/>
            </Grid>

            <!-- Who's online -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Sk.Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock x:Name="OnlineHeader" DockPanel.Dock="Top" Margin="12,10,8,6" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Sk.TextMuted}" Text="ONLINE"/>
                    <ScrollViewer Style="{StaticResource Sk.ScrollViewer}">
                        <ItemsControl x:Name="UserList" Margin="12,0,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type s:ChatUser}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="6" Height="6" Fill="#5BD65B" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UserName" Text="{Binding Name}" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="You" Text="(you)" Margin="5,0,0,0" Visibility="Collapsed"
                                                   Foreground="{StaticResource Sk.TextDisabled}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsYou}" Value="True">
                                            <Setter TargetName="You" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="UserName" Property="Foreground" Value="{DynamicResource Sk.Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Input -->
        <Border Grid.Row="3" Padding="10,8" BorderBrush="{StaticResource Sk.Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Input" Margin="0" Height="24" MaxLength="500" PreviewKeyDown="Input_PreviewKeyDown"/>
                <TextBlock Text="Write a message..." Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource Sk.TextDisabled}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="Send" Width="70" Height="24" Margin="8,0,0,0" Click="Send_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
