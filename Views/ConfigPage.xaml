<UserControl x:Class="Apathy.Views.ConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Presets">
            <StackPanel>
                <ListBox x:Name="ConfigList" Height="180" SelectionChanged="ConfigList_SelectionChanged"/>
                <TextBox x:Name="NameBox"/>
                <Button Content="Load" Click="Load_Click"/>
                <Button Content="Save" Click="Save_Click"/>
                <Button Content="Delete" Click="Delete_Click"/>
                <Button Content="Reset" Click="Reset_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Sharing">
            <StackPanel>
                <Button Content="Import from clipboard" Click="Import_Click"/>
                <Button Content="Export to clipboard" Click="Export_Click"/>
                <Button Content="Open configs folder" Click="OpenFolder_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Sk.Label}" Margin="20,6,30,0"
                           Foreground="{StaticResource Sk.TextMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
