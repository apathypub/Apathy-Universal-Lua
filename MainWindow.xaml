<Window x:Class="Apathy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Apathy.Views"
        xmlns:c="clr-namespace:Apathy.Controls"
        Title="Apathy"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource Sk.Outline}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Sk.Font}"
        FontSize="{StaticResource Sk.FontSize}"
        Foreground="{StaticResource Sk.Text}">

    <!-- Flat forum look: one thin edge, the page colour, a header, then the text nav. -->
    <Border x:Name="Root" Width="660" Height="560"
            LayoutTransform="{DynamicResource Sk.Scale}"
            Background="{DynamicResource Sk.Pattern}"
            BorderBrush="{StaticResource Sk.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: the apathy wordmark with the coral pulse, the user on the right. -->
            <Grid Grid.Row="0" Margin="18,15,18,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="apathy" FontFamily="{StaticResource Sk.Heading}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Sk.Text}"/>
                    <!-- EKG pulse line in coral, like the forum logo. -->
                    <Polyline Points="0,6 7,6 10,1 14,11 18,6 40,6" Stroke="{StaticResource Sk.Coral}" StrokeThickness="1.4"
                              VerticalAlignment="Center" Margin="10,2,0,0" StrokeLineJoin="Round"/>
                </StackPanel>
                <TextBlock x:Name="UserText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Sk.Accent}"/>
            </Grid>

            <!-- Tab headers are lowercase text (the nav bar is drawn by the TabControl template). -->
            <TabControl x:Name="MainTabs" Grid.Row="1" AllowDrop="True"
                        PreviewMouseLeftButtonDown="MainTabs_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="MainTabs_PreviewMouseMove"
                        Drop="MainTabs_Drop">
                <TabItem x:Name="GeneralTab" Header="general" ToolTip="General" AutomationProperties.Name="General">
                    <v:GeneralPage/>
                </TabItem>
                <TabItem x:Name="LuaTab" Header="lua" ToolTip="Lua" AutomationProperties.Name="Lua">
                    <v:LuaPage/>
                </TabItem>
                <TabItem x:Name="ChatTab" Header="chatlive" ToolTip="ChatLive" AutomationProperties.Name="ChatLive">
                    <v:ChatView BorderBrush="{StaticResource Sk.Black}" BorderThickness="1"/>
                </TabItem>
                <TabItem Header="misc" ToolTip="Misc" AutomationProperties.Name="Misc">
                    <v:MiscPage/>
                </TabItem>
                <TabItem Header="config" ToolTip="Config" AutomationProperties.Name="Config">
                    <v:ConfigPage/>
                </TabItem>
            </TabControl>

            <Thumb x:Name="ResizeGrip" Grid.Row="1" Width="10" Height="10"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Fill="{StaticResource Sk.Line}" RenderOptions.EdgeMode="Aliased"
                                  Data="M7,1 h2 v2 h-2 Z M4,4 h2 v2 h-2 Z M7,4 h2 v2 h-2 Z M1,7 h2 v2 h-2 Z M4,7 h2 v2 h-2 Z M7,7 h2 v2 h-2 Z"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
